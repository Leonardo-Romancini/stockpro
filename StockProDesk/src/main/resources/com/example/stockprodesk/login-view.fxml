<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="651.0" prefWidth="638.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.stockprodesk.LoginController">
   <children>
      <ImageView fitHeight="816.0" fitWidth="644.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../images/spring.jpg" />
         </image></ImageView>
      <Label layoutX="16.0" layoutY="52.0" text="Usuário" textFill="#e1ff00" />

      <TextField fx:id="txtLogin" layoutX="68.0" layoutY="48.0" />

      <Label layoutX="22.0" layoutY="97.0" text="Senha" textFill="#f2ff00" />

      <PasswordField fx:id="txtSenha" layoutX="68.0" layoutY="93.0" />

      <Button onAction="#onLoginButtonClick" layoutX="65.0" layoutY="135.0" mnemonicParsing="false"  prefHeight="25.0" prefWidth="155.0" text="Login" />
   </children>
</AnchorPane>
